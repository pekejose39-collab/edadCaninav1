<?xml version="1.0" encoding="utf-8"?>
<!-- <layout> como raíz le dice a DataBinding que genere ActivityMainBinding
     (nombre del fichero en PascalCase + "Binding"). Los xmlns suben aquí porque
     ahora esta es la etiqueta raíz del documento. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- <data> declara con qué objetos Java se enlaza este layout. Los <import>
         hacen falta para usar View.VISIBLE o Validacion.OK en las expresiones. -->
    <data>
        <import type="android.view.View" />
        <import type="es.davante.edadcanina.modelo.Validacion" />

        <variable
            name="modelo"
            type="es.davante.edadcanina.modelo.EdadCaninaModelo" />

        <!-- Segunda variable: los clics van al controlador, no a la Activity. -->
        <variable
            name="controlador"
            type="es.davante.edadcanina.controlador.EdadCaninaControlador" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".MainActivity">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/txt_titulo"
            android:textSize="32sp" />

        <ImageView
            android:layout_width="192dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/imgdog" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/input_age"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <!-- @={...} es bidireccional: lo que escribe el usuario llega al modelo
             (setEdadTexto) y si el modelo cambia el texto, el campo se actualiza.
             app:errorValidacion es un atributo inventado: lo programa
             AdaptadoresVista.mostrarErrorValidacion. Al escribir, el modelo pasa a
             SIN_CALCULAR y el error desaparece solo. -->
        <EditText
            android:id="@+id/age_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:gravity="center"
            android:hint="@string/hint_edad"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2"
            android:text="@={modelo.edadTexto}"
            android:textSize="48sp"
            app:errorValidacion="@{modelo.validacion}" />

        <!-- @{...} va solo del modelo a la vista. El texto sale del recurso con
             formato y solo se ve si la validación es OK. Uso INVISIBLE y no GONE
             para que el resultado siga ocupando su hueco y los botones no salten
             arriba y abajo al calcular. -->
        <TextView
            android:id="@+id/result_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@{@string/tu_edad_format(modelo.edadHumana)}"
            android:textSize="16sp"
            android:visibility="@{modelo.validacion == Validacion.OK ? View.VISIBLE : View.INVISIBLE}" />

        <!-- Los dos botones en fila: orientación horizontal y layout_weight="1"
             con width 0dp para que se repartan el ancho a partes iguales.
             onClick con una lambda: se evalúa al pulsar y llama al controlador.
             Si controlador fuera null, la lambda no haría nada (sin NPE). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_calc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:onClick="@{() -> controlador.onCalcularClick()}"
                android:text="@string/btn_calc"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_limpiar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:onClick="@{() -> controlador.onLimpiarClick()}"
                android:text="@string/btn_limpiar"
                android:textSize="22sp" />
        </LinearLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>